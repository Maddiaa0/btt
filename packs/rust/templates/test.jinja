{% set pad = "" if in_tests_dir else "    " -%}
{% if not in_tests_dir -%}
#[cfg(test)]
mod tests {
    use super::*;

{% endif -%}
{% for ev in events -%}
{% if ev.kind == "open" -%}
{{ pad }}{{ ev.indent }}mod {{ ev.name }} {
{{ pad }}{{ ev.indent }}    use super::*;

{% elif ev.kind == "close" -%}
{{ pad }}{{ ev.indent }}}

{% elif ev.kind == "test" -%}
{{ pad }}{{ ev.indent }}#[test]
{{ pad }}{{ ev.indent }}fn {{ ev.name }}() {
{{ pad }}{{ ev.indent }}    todo!("{{ ev.text | rust_string }}");
{{ pad }}{{ ev.indent }}}

{% endif -%}
{% endfor -%}
{% if not in_tests_dir -%}
}
{% endif -%}
